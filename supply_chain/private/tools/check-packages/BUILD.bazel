load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_test")

go_binary(
    name = "check-packages",
    srcs = [
        "assets.go",
        "check.go",
        "licence.go",
        "main.go",
        "verdict.go",
    ],
    embedsrcs = glob([
        "assets/spdx/*",
        "assets/generated/spdx/*",
    ]),
    pure = "on",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//:__subpackages__"],
    deps = [
        "//supply_chain/private/tools/internal/cli:lib",
        "//supply_chain/private/tools/internal/jsondata:lib",
        "//supply_chain/private/tools/internal/metadata:lib",
        "//supply_chain/private/tools/internal/osv:lib",
        "//supply_chain/private/tools/internal/policy:lib",
        "//supply_chain/private/tools/internal/purl:lib",
    ],
)

