module(name = "latticebuild_supply_chain_consumer")

bazel_dep(name = "latticebuild_supply_chain", version = "0.1.1", repo_name = "subject")
local_path_override(
    module_name = "latticebuild_supply_chain",
    path = "..",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "package_metadata", version = "0.0.13")
bazel_dep(name = "rules_rust", version = "0.74.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.98.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")
