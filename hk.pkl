amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"
import "pkl/hk/gofmt.pkl"
import "pkl/hk/buildifier.pkl"
min_hk_version = "2.0.0"
hide_warnings = List("missing-profiles")
steps {
  ["bom"] = (Builtins.byte_order_marker) { exclude = List("supply_chain/private/tools/check-packages/assets/generated/**") }
  ["merge-conflicts"] = Builtins.check_merge_conflict
  ["newlines"] = (Builtins.newlines) { exclude = List("supply_chain/private/tools/check-packages/assets/generated/**") }
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) { exclude = List("supply_chain/private/tools/check-packages/assets/generated/**") }
  ["buildifier-format"] = buildifier.format
  ["buildifier-lint"] = (buildifier.lint) { depends = "buildifier-format" }
  ["gofmt"] = gofmt.step
  ["actionlint"] = Builtins.actionlint
}
