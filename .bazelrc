common --enable_bzlmod
common --incompatible_enforce_config_setting_visibility
build --incompatible_config_setting_private_default_visibility
test --test_output=errors

# Rust doctest launchers use a runfiles tree, including on Windows.
build --enable_runfiles

# Use the downloaded sysroot so rustdoc resolves standard libraries at test time.
build --@rules_rust//rust/settings:toolchain_generated_sysroot=false
